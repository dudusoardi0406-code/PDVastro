# Copie para .env.local (desenvolvimento) e cadastre as mesmas chaves na Vercel
# (Settings > Environment Variables) nos ambientes Development, Preview e Production.

# --- Supabase (Project Settings > API) -------------------------------------
# Se você conectou pela integração Supabase da Vercel, ela já cria
# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY;
# o sistema aceita esses nomes também.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# chave secreta (service_role): NUNCA com prefixo NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Pix -------------------------------------------------------------------
# mock = QR de teste + botão "Simular pagamento" (Development e Preview)
# itau = API Pix do Itaú (Production, quando as credenciais chegarem)
PIX_PROVIDER=mock

# Segredo que vai na URL do webhook (mínimo 16 caracteres, só letras e números)
PIX_WEBHOOK_SECRET=troque-por-um-segredo-longo-123456

# A Vercel envia "Authorization: Bearer $CRON_SECRET" no cron de conciliação
CRON_SECRET=troque-por-outro-segredo-longo-654321

# --- Itaú (só com PIX_PROVIDER=itau) ----------------------------------------
ITAU_CLIENT_ID=
ITAU_CLIENT_SECRET=
# certificado e chave gerados no portal do Itaú, em base64:
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("certificado.crt"))
ITAU_CERT_B64=
ITAU_KEY_B64=
# ITAU_KEY_PASSPHRASE=
# chave Pix da conta PJ que recebe (CNPJ só números, e-mail, telefone ou aleatória)
ITAU_PIX_KEY=
# Confirmar com o Itaú. Padrões usados se ficarem vazias:
# ITAU_TOKEN_URL=https://sts.itau.com.br/api/oauth/token
# ITAU_PIX_BASE_URL=https://secure.api.itau/pix_recebimentos/v2
ITAU_TOKEN_URL=
ITAU_PIX_BASE_URL=
